{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siftory",
  "version": "0.1.0",
  "identifier": "ai.appchain.siftory",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ui build && bun ../../scripts/build-sidecar.ts --current"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Siftory",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../bin/siftory-agent"
    ]
  }
}
